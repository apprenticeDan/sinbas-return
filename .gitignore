# ============================================================
#  TAURI
# ============================================================
 
# Bundles generados (instaladores: .msi, .deb, .AppImage, .dmg, .app, .exe)
src-tauri/target/
src-tauri/WixTools/
 
# Iconos generados automáticamente por `tauri icon`
# (solo si los generas desde un PNG fuente — si los editas a mano, comenta esto)
src-tauri/icons/
 
# Archivos de firma y actualización automática (Tauri updater)
*.sig
latest.json
update-manifest.json
 
# Caché de Tauri CLI
.tauri/

*.txt
