meta {
  name: 12 - Registrar egreso en gramos sobre producto con stock en kg
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/inventario/egreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "productoId": "{{testProductoId}}",
    "descripcion": "{{testNombreVisible}}",
    "tipoEgreso": "Venta",
    "cantidad": 500,
    "unidad": "g",
    "contraparteNombre": "Cliente AgroForestal",
    "departamento": "",
    "solicitante": "",
    "observaciones": "Egreso de 500g sobre lote de 1.5kg",
    "fecha": "2026-10-06T11:00:00Z"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.tipo: eq "Salida"
}
