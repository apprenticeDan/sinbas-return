meta {
  name: 04 - Registrar ingreso a almacen
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "productoId": "{{testProductoId}}",
    "loteId": "",
    "descripcion": "{{testNombreVisible}}",
    "categoria": "Semilla",
    "tipoIngreso": "Recoleccion",
    "cantidad": 500,
    "unidad": "g",
    "procedencia": "Bosque Comunal Tunari",
    "observaciones": "Ingreso prueba de integracion",
    "fecha": "2026-10-05T10:00:00Z"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.tipo: eq "Entrada"
  res.body.lineas: isArray
  res.body.lineas.length: gte 1
}

vars:post-response {
  testLoteId: res.body.lineas[0].loteId
  testCodigoLote: res.body.lineas[0].codigoLote
}
