meta {
  name: 04 - Rechazo de confirmacion proforma anonima sin cliente registrado
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/proformas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComercial}}
}

body:json {
  {
    "clienteNombreLibre": "Comprador Ocasional Mostrador",
    "lineas": [
      {
        "productoId": "01917f3a-0003-7000-8000-000000000001",
        "cantidad": 1.0,
        "unidad": "kg"
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
}

vars:post-response {
  proformaAnonimaId: res.body.id
}
