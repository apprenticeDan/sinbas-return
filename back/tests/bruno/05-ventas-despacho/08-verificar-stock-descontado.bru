meta {
  name: 08 - Verificar deduccion real de stock tras despacho
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/inventario/stock/01917f3a-0003-7000-8000-000000000001
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacen}}
}

assert {
  res.status: eq 200
  res.body.stockTotalGramos: isNumber
  res.body.stockDisponibleVentaGramos: isNumber
}
