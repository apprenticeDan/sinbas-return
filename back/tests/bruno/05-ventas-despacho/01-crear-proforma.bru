meta {
  name: 01 - Crear proforma valida con cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/proformas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComercial}}
}

body:json {
  {
    "clienteId": "01917f3a-0006-7000-8000-000000000001",
    "lineas": [
      {
        "productoId": "01917f3a-0003-7000-8000-000000000001",
        "cantidad": 5.0,
        "unidad": "kg"
      }
    ],
    "observaciones": "Proforma para venta y posterior despacho F8"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.estado: eq "Vigente"
  res.body.total: eq 750
  res.body.clienteId: eq "01917f3a-0006-7000-8000-000000000001"
}

vars:post-response {
  proformaF8Id: res.body.id
}
