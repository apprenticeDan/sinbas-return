meta {
  name: 04b - Rechazo al confirmar proforma anonima sin enviar clienteId
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/proformas/{{proformaAnonimaId}}/confirmar-venta
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComercial}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.error: contains "Cliente"
}
