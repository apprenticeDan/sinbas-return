meta {
  name: Crear test_almacen
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombres": "Test",
    "apellidoPaterno": "Almacen",
    "ciNumero": "9000001",
    "ciExtension": "CB",
    "telefono": "70000002",
    "email": "test_almacen@test.local",
    "nombreUsuario": "test_almacen",
    "contrasena": "{{testPass}}",
    "roles": ["Almacen"]
  }
}

assert {
  res.status: in [201, 409]
}

docs {
  201 = creado. 409 = ya existia (permite re-ejecutar la coleccion).
}
