meta {
  name: Crear test_comercial
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombres": "Test",
    "apellidoPaterno": "Comercial",
    "ciNumero": "9000004",
    "ciExtension": "CB",
    "telefono": "70000005",
    "email": "test_comercial@test.local",
    "nombreUsuario": "test_comercial",
    "contrasena": "{{testPass}}",
    "roles": ["Comercial"]
  }
}

assert {
  res.status: in [201, 409]
}

docs {
  201 = creado. 409 = ya existia (permite re-ejecutar la coleccion).
}
