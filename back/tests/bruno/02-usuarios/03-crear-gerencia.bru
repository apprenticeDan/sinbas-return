meta {
  name: Crear test_gerencia
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombres": "Test",
    "apellidoPaterno": "Gerencia",
    "ciNumero": "9000003",
    "ciExtension": "CB",
    "telefono": "70000004",
    "email": "test_gerencia@test.local",
    "nombreUsuario": "test_gerencia",
    "contrasena": "{{testPass}}",
    "roles": ["Gerencia"]
  }
}

assert {
  res.status: in [201, 409]
}

docs {
  201 = creado. 409 = ya existia (permite re-ejecutar la coleccion).
}
