meta {
  name: Login laboratorio
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_lab",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  tokenLab: res.body.token
}
