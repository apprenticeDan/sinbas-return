meta {
  name: Login almacen
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_almacen",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  tokenAlmacen: res.body.token
}
