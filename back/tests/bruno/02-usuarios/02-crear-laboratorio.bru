meta {
  name: Crear test_lab
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombres": "Test",
    "apellidoPaterno": "Laboratorio",
    "ciNumero": "9000002",
    "ciExtension": "CB",
    "telefono": "70000003",
    "email": "test_lab@test.local",
    "nombreUsuario": "test_lab",
    "contrasena": "{{testPass}}",
    "roles": ["Laboratorio"]
  }
}

assert {
  res.status: in [201, 409]
}

docs {
  201 = creado. 409 = ya existia (permite re-ejecutar la coleccion).
}
