meta {
  name: Login comercial
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_comercial",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  tokenComercial: res.body.token
}
