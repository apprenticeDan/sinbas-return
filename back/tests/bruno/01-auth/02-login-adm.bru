meta {
  name: Login admin OK
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "{{adminUser}}",
    "contrasena": "{{adminPass}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.roles: contains "Administrador"
}

vars:post-response {
  tokenAdmin: res.body.token
}
