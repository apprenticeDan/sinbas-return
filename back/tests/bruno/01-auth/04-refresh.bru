meta {
  name: Refresh con cookie
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.token: isString
}

vars:post-response {
  tokenRefrescado: res.body.token
}

docs {
  Usa la cookie sinbas_refresh_token. En la app de Bruno funciona;
  en el CLI puede dar 401 si no persiste cookies. Si pasa, correr 04-06 desde la app.
}

