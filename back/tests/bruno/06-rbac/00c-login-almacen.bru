meta {
  name: 00c - Login almacen (RBAC)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_almacen",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

vars:post-response {
  tokenRbacAlmacen: res.body.token
}
