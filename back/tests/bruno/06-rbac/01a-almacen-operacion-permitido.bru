meta {
  name: 01a - RequireAlmacenOperacion permitido (Almacen)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRbacAlmacen}}
}

body:json {
  {
    "productoId": "01917f3a-0003-7000-8000-000000000002",
    "loteId": "",
    "descripcion": "Cedrela odorata - Ingreso RBAC",
    "categoria": "Semilla",
    "tipoIngreso": "Recoleccion",
    "cantidad": 100,
    "unidad": "g",
    "procedencia": "Bosque Comunal RBAC",
    "observaciones": "Lote creado para pruebas de RBAC",
    "fecha": "2026-10-14T10:00:00Z"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.tipo: eq "Entrada"
  res.body.lineas: isArray
  res.body.lineas.length: gte 1
}

vars:post-response {
  rbacLoteId: res.body.lineas[0].loteId
}
