meta {
  name: 00e - Login comercial (RBAC)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_comercial",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

vars:post-response {
  tokenRbacComercial: res.body.token
}
