meta {
  name: 00b - Login gerencia (RBAC)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "test_gerencia",
    "contrasena": "{{testPass}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

vars:post-response {
  tokenRbacGerencia: res.body.token
}
