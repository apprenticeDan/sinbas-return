meta {
  name: 00 - Login comercial
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuarioRaw": "{{adminUser}}",
    "contrasena": "{{adminPass}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

vars:post-response {
  tokenComercial: res.body.token
}
